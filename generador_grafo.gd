extends Node

# Este botón aparecerá en el panel del Inspector en Godot. 
# Al hacerle clic (activarlo), se ejecutará el código mágicamente.
@export var generar_archivo_ahora: bool = false:
	set(value):
		if value:
			_construir_y_guardar_grafo()
			generar_archivo_ahora = false # Se desactiva automáticamente

