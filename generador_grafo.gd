func _construir_y_guardar_grafo():
	print("Iniciando construcción del grafo de PARCHAOS...")
	var astar = AStar3D.new()
	
	# 1. Registrar todos los nodos en el AStar
	for i in range(posiciones_nodos.size()):
		astar.add_point(i, posiciones_nodos[i])
		
	# 2. Conectar los vecinos verificando que no crucen muros
	var conexiones_hechas = 0
	
	for i in range(posiciones_nodos.size()):
		for j in range(i + 1, posiciones_nodos.size()): # Evitar conectar un nodo consigo mismo o repetir pares
			var pos_a = posiciones_nodos[i]
			var pos_b = posiciones_nodos[j]
			
			# Solo intentamos conectar si están cerca (son vecinos)
			if pos_a.distance_to(pos_b) <= distancia_maxima_vecinos:
				
				# La prueba de fuego: ¿Atraviesan un muro?
				if _conexion_es_limpia(pos_a, pos_b):
					astar.connect_points(i, j)
					conexiones_hechas += 1

	# 3. Guardar el resultado en tu disco duro
	var ruta_guardado = "res://scripts/grafo_parchaos.tres"
	var error = ResourceSaver.save(astar, ruta_guardado)
	
	if error == OK:
		print("¡ÉXITO! Grafo guardado en: ", ruta_guardado)
		print("Se generaron ", conexiones_hechas, " conexiones limpias.")
	else:
		print("Hubo un error al guardar: ", error)

# La función matemática para chocar contra los 4 puntos
func _conexion_es_limpia(pos_a: Vector3, pos_b: Vector3) -> bool:
	# Convertimos a 2D (vista desde arriba, ejes X y Z) porque los muros 
	# son barreras verticales en el mapa. Esto hace el cálculo ultra rápido.
	var a2d = Vector2(pos_a.x, pos_a.z)
	var b2d = Vector2(pos_b.x, pos_b.z)
	
	for muro in muros:
		# Extraemos las 4 esquinas del muro en 2D
		var p1 = Vector2(muro[0].x, muro[0].z)
		var p2 = Vector2(muro[1].x, muro[1].z)
		var p3 = Vector2(muro[2].x, muro[2].z)
		var p4 = Vector2(muro[3].x, muro[3].z)
		
		# Verificamos si la línea de conexión corta alguna de las 4 caras del muro
		if Geometry2D.segment_intersects_segment(a2d, b2d, p1, p2) != null: return false
		if Geometry2D.segment_intersects_segment(a2d, b2d, p2, p3) != null: return false
		if Geometry2D.segment_intersects_segment(a2d, b2d, p3, p4) != null: return false
		if Geometry2D.segment_intersects_segment(a2d, b2d, p4, p1) != null: return false
		
	# Si pasó por todos los muros sin chocar con ninguno, la vía está libre
	return true
